// Prisma schema for the Flowbase workspace.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Starter model mirroring @flowbase/shared-dto UserDto.
model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  name               String?
  displayName        String?
  passwordHash       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  hashedRefreshToken String?
}
