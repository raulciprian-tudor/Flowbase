{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "Node16",
    "moduleResolution": "node16",
    "types": ["jest", "node"],
    "incremental": true,
    "tsBuildInfoFile": "../../dist/out-tsc/spec.tsbuildinfo"
  },
  "include": ["jest.config.ts", "jest.config.cts", "src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.d.ts"]
}
